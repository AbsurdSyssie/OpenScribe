DATABASE_URL=postgresql+psycopg://ambient:ambient@localhost:5432/ambient_scribe
TEST_DATABASE_URL=postgresql+psycopg://ambient:ambient@localhost:5432/ambient_scribe_test
APP_HOST=127.0.0.1
APP_PORT=8080
APP_SECRET_KEY=change-me-for-dev
CSRF_SECRET=
CSRF_SECRET_VAULT_REF=
COOKIE_SECURE_MODE=auto
# HSTS_SOURCE=app means FastAPI emits Strict-Transport-Security for all HTTPS responses.
# Use HSTS_SOURCE=proxy only when Cloudflare/reverse proxy owns HSTS for all responses.
# Use HSTS_SOURCE=proxy_static_fallback when proxy covers dynamic pages but misses /static/ assets.
HSTS_SOURCE=app
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/0
TEST_RATE_LIMIT_STORAGE_URL=redis://localhost:6379/15
LIVE_CHUNK_UPLOAD_RATE_LIMIT=1/second
WHOLE_FILE_UPLOAD_BURST_RATE_LIMIT=1/5 seconds
WHOLE_FILE_UPLOAD_DAILY_RATE_LIMIT=100/day
LLM_GENERATION_BURST_RATE_LIMIT=20/3 minutes
LLM_GENERATION_DAILY_RATE_LIMIT=200/day
# Audit IP capture trusts request.client.host by default.
# Enable proxy/CDN headers only when trusted infrastructure sanitizes them and direct origin access is blocked.
AUDIT_TRUST_X_FORWARDED_FOR=false
AUDIT_TRUST_CLOUDFLARE=false
# Quotas are authoritative after configuration; these safeguards remain enabled for unlimited users.
LIVE_CHUNK_HOURLY_DURATION_LIMIT_SECONDS=3600
WHOLE_FILE_HOURLY_UPLOAD_BYTES=209715200
WHOLE_FILE_HOURLY_DURATION_LIMIT_SECONDS=14400
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_LOG_LEVEL=INFO
MAIL_TRANSPORT=disabled
APP_ENV=local
APP_PUBLIC_URL=http://127.0.0.1:8080
# If unset, API docs are public only outside production. Set false in production
# to require full system-admin auth for /docs, /redoc, and /openapi.json.
PUBLIC_API_DOCS=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=OpenScribe
MAIL_REPLY_TO=
RESEND_API_KEY=
RESEND_API_KEY_VAULT_REF=
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_TOKEN_FILE=.local/vault/root-token
VAULT_KV_MOUNT=secret
DEV_START_CELERY=true
DEV_ALLOW_REMOTE_BIND=false
# Comma-separated proxy IPs whose X-Forwarded-* headers FastAPI may trust in dev.
DEV_FORWARDED_ALLOW_IPS=192.168.1.234
DEV_ALLOW_REMOTE_SERVICE_EXPOSURE=false
DEV_SEED_TEST_ACCOUNTS=true
DEV_TEST_TEAM_NAME=Dev Test Team
DEV_TEST_ADMIN_EMAIL=dev.admin@example.com
DEV_TEST_ADMIN_PASSWORD=test1234
DEV_TEST_LEADER_EMAIL=dev.leader@example.com
DEV_TEST_LEADER_PASSWORD=test1234
DEV_TEST_USER_EMAIL=dev.user@example.com
DEV_TEST_USER_PASSWORD=test1234
OWASP_LIFECYCLE_ADMIN_EMAIL=
OWASP_LIFECYCLE_ADMIN_PASSWORD=
OWASP_LIFECYCLE_ADMIN_SESSION=
HALLUCINATION_CHECK_DEBUG_UI=1
