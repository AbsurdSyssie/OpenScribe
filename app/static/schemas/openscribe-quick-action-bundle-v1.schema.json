{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenScribe quick action bundle version 1",
  "type": "object",
  "required": ["format", "format_version", "quick_actions"],
  "properties": {
    "format": {"const": "openscribe-quick-action-bundle"},
    "format_version": {"const": 1},
    "quick_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/quick_action"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "quick_action": {
      "type": "object",
      "required": ["name", "description", "latest_version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "description": {"type": ["string", "null"]},
        "latest_version": {"$ref": "#/$defs/version"}
      },
      "additionalProperties": true
    },
    "version": {
      "type": "object",
      "required": ["mode", "prompt_text"],
      "properties": {
        "mode": {"const": "freeform"},
        "prompt_text": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  }
}
