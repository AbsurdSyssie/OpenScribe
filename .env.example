# Copy this file to .env. Do not commit .env.
# These values are safe local-development defaults. See docs/environment.md
# before using OpenScribe behind a proxy or with APP_ENV=production.

# -----------------------------------------------------------------------------
# Application and HTTP
# -----------------------------------------------------------------------------
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8080
APP_PUBLIC_URL=http://127.0.0.1:8080

# Prefer CSRF_SECRET. SECRET_KEY is a supported compatibility alias.
# Local/test environments use a development-only fallback when both are blank.
CSRF_SECRET=
SECRET_KEY=
CSRF_SECRET_VAULT_REF=
COOKIE_SECURE_MODE=auto

# app: OpenScribe owns HSTS; proxy: the reverse proxy owns every response;
# proxy_static_fallback: the proxy owns dynamic responses and OpenScribe covers
# static assets that the proxy misses.
HSTS_SOURCE=app

# Unset means public outside production and system-admin-only in production.
PUBLIC_API_DOCS=

# Only trust these headers when a sanitizing proxy/CDN is the sole route to the
# application origin.
AUDIT_TRUST_X_FORWARDED_FOR=false
AUDIT_TRUST_CLOUDFLARE=false

# -----------------------------------------------------------------------------
# Database, Redis, and Celery
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://ambient:ambient@localhost:5432/ambient_scribe
TEST_DATABASE_URL=postgresql+psycopg://ambient:ambient@localhost:5432/ambient_scribe_test
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/0
TEST_RATE_LIMIT_STORAGE_URL=redis://localhost:6379/15
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_LOG_LEVEL=INFO

# Test-only switch. Do not enable for a persistent runtime.
CELERY_TASK_ALWAYS_EAGER=false

# -----------------------------------------------------------------------------
# Vault
# -----------------------------------------------------------------------------
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_TOKEN_FILE=.local/vault/root-token
VAULT_KV_MOUNT=secret
VAULT_TRANSIT_MOUNT=transit
VAULT_USER_CONTENT_KEK_KEY_NAME=openscribe-user-content-kek
LOCAL_VAULT_WAIT_TIMEOUT_SECONDS=90
LOCAL_VAULT_WAIT_RETRY_INTERVAL_SECONDS=1

# -----------------------------------------------------------------------------
# Transactional email
# -----------------------------------------------------------------------------
MAIL_TRANSPORT=disabled
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=OpenScribe
MAIL_REPLY_TO=
RESEND_API_KEY=
RESEND_API_KEY_VAULT_REF=

# -----------------------------------------------------------------------------
# Provider-call safeguards and quotas
# -----------------------------------------------------------------------------
LIVE_CHUNK_UPLOAD_RATE_LIMIT=1/second
WHOLE_FILE_UPLOAD_BURST_RATE_LIMIT=1/5 seconds
WHOLE_FILE_UPLOAD_DAILY_RATE_LIMIT=100/day
LLM_GENERATION_BURST_RATE_LIMIT=20/3 minutes
LLM_GENERATION_DAILY_RATE_LIMIT=200/day
LIVE_CHUNK_HOURLY_DURATION_LIMIT_SECONDS=3600
WHOLE_FILE_HOURLY_UPLOAD_BYTES=209715200
WHOLE_FILE_HOURLY_DURATION_LIMIT_SECONDS=14400

# Hard upload and normalization limits.
WHOLE_FILE_MAX_UPLOAD_BYTES=209715200
WHOLE_FILE_MAX_DURATION_SECONDS=14400
AUDIO_FFPROBE_TIMEOUT_SECONDS=15
AUDIO_FFMPEG_TIMEOUT_SECONDS=1800

# -----------------------------------------------------------------------------
# Persistent Docker runtime
# -----------------------------------------------------------------------------
# Host interface used for the published web port. Keep localhost unless a
# trusted reverse proxy or private network must connect directly.
DOCKER_APP_BIND=127.0.0.1
DOCKER_SEED_TEST_ACCOUNTS=false
CELERY_WORKER_CONCURRENCY=1
CONTAINER_STARTUP_TIMEOUT_SECONDS=90

# Uvicorn proxy addresses whose Forwarded/X-Forwarded-* headers are trusted by
# the container runtime. Do not use * unless direct origin access is blocked.
FORWARDED_ALLOW_IPS=127.0.0.1

# -----------------------------------------------------------------------------
# Host-based development workflow (start-dev.sh only)
# -----------------------------------------------------------------------------
DEV_START_CELERY=true
DEV_START_BRAVE=true
DEV_ALLOW_REMOTE_BIND=false
DEV_FORWARDED_ALLOW_IPS=192.168.1.234
DEV_ALLOW_REMOTE_SERVICE_EXPOSURE=false
DEV_RESTART_EXISTING_PROCESSES=true
DEV_PURGE_CELERY_QUEUE=true
DEV_SEED_TEST_ACCOUNTS=true
DEV_TEST_TEAM_NAME=Dev Test Team
DEV_TEST_ADMIN_EMAIL=dev.admin@example.com
DEV_TEST_ADMIN_PASSWORD=test1234
DEV_TEST_LEADER_EMAIL=dev.leader@example.com
DEV_TEST_LEADER_PASSWORD=test1234
DEV_TEST_USER_EMAIL=dev.user@example.com
DEV_TEST_USER_PASSWORD=test1234

# -----------------------------------------------------------------------------
# Security test helpers; leave blank/disabled for normal runtime use
# -----------------------------------------------------------------------------
OWASP_LIFECYCLE_ADMIN_EMAIL=
OWASP_LIFECYCLE_ADMIN_PASSWORD=
OWASP_LIFECYCLE_ADMIN_SESSION=
HALLUCINATION_CHECK_DEBUG_UI=0
