{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenScribe template bundle version 1",
  "type": "object",
  "required": ["format", "format_version", "templates"],
  "properties": {
    "format": {"const": "openscribe-template-bundle"},
    "format_version": {"const": 1},
    "templates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/template"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "template": {
      "type": "object",
      "required": ["name", "description", "latest_version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "description": {"type": ["string", "null"]},
        "latest_version": {"$ref": "#/$defs/version"}
      },
      "additionalProperties": true
    },
    "version": {
      "type": "object",
      "required": ["mode", "prompt_text", "config_json"],
      "properties": {
        "mode": {"enum": ["freeform", "structured"]},
        "prompt_text": {"type": "string", "minLength": 1},
        "config_json": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/structured_config"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "freeform"}}},
          "then": {"properties": {"config_json": {"type": "null"}}}
        },
        {
          "if": {"properties": {"mode": {"const": "structured"}}},
          "then": {"properties": {"config_json": {"$ref": "#/$defs/structured_config"}}}
        }
      ],
      "additionalProperties": true
    },
    "structured_config": {
      "type": "object",
      "required": ["profile", "sections"],
      "properties": {
        "profile": {"const": "emis"},
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "prefixItems": [
            {"$ref": "#/$defs/section_order_1"},
            {"$ref": "#/$defs/section_order_2"},
            {"$ref": "#/$defs/section_order_3"},
            {"$ref": "#/$defs/section_order_4"},
            {"$ref": "#/$defs/section_order_5"},
            {"$ref": "#/$defs/section_order_6"},
            {"$ref": "#/$defs/section_order_7"},
            {"$ref": "#/$defs/section_order_8"}
          ],
          "items": false,
          "allOf": [
            {"contains": {"properties": {"section_key": {"const": "problem"}}, "required": ["section_key"]}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"section_key": {"const": "history"}}, "required": ["section_key"]}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"section_key": {"const": "family_history"}}, "required": ["section_key"]}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"section_key": {"const": "social_history"}}, "required": ["section_key"]}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"section_key": {"const": "examination"}}, "required": ["section_key"]}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"section_key": {"const": "comment"}}, "required": ["section_key"]}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"section_key": {"const": "tasks"}}, "required": ["section_key"]}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"section_key": {"const": "investigations"}}, "required": ["section_key"]}, "minContains": 0, "maxContains": 1}
          ]
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["section_key", "instruction", "section_order"],
      "properties": {
        "section_key": {"enum": ["problem", "history", "family_history", "social_history", "examination", "comment", "tasks", "investigations"]},
        "instruction": {"type": "string", "minLength": 1},
        "section_order": {"type": "integer", "minimum": 1, "maximum": 8}
      },
      "additionalProperties": false
    },
    "section_order_1": {
      "allOf": [{"$ref": "#/$defs/section"}, {"properties": {"section_order": {"const": 1}}}]
    },
    "section_order_2": {
      "allOf": [{"$ref": "#/$defs/section"}, {"properties": {"section_order": {"const": 2}}}]
    },
    "section_order_3": {
      "allOf": [{"$ref": "#/$defs/section"}, {"properties": {"section_order": {"const": 3}}}]
    },
    "section_order_4": {
      "allOf": [{"$ref": "#/$defs/section"}, {"properties": {"section_order": {"const": 4}}}]
    },
    "section_order_5": {
      "allOf": [{"$ref": "#/$defs/section"}, {"properties": {"section_order": {"const": 5}}}]
    },
    "section_order_6": {
      "allOf": [{"$ref": "#/$defs/section"}, {"properties": {"section_order": {"const": 6}}}]
    },
    "section_order_7": {
      "allOf": [{"$ref": "#/$defs/section"}, {"properties": {"section_order": {"const": 7}}}]
    },
    "section_order_8": {
      "allOf": [{"$ref": "#/$defs/section"}, {"properties": {"section_order": {"const": 8}}}]
    }
  }
}
